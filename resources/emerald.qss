/* Emerald — neutral charcoal dark theme with emerald accents (selection,
   focus, chevrons) sampled from the app icon. */

QMainWindow,
QWidget {
    background: #17181b;
    color: #a9c8b8;
}

QTextEdit#editor,
QPlainTextEdit#editor {
    background: #17181b;
    color: #d7eee2;
    border: none;
    selection-background-color: #1f4a33;
    selection-color: #d7eee2;
}

/* The note title shown as the first line above the body (maps to the file
   name; the .md is never shown). */
QLineEdit#noteTitle {
    background: #17181b;
    color: #cfe8dc;
    border: none;
    padding: 18px 18px 14px 18px;
    font-size: 26px;
    font-weight: 700;
    selection-background-color: #1f4a33;
}
QLineEdit#noteTitle::placeholder {
    color: #2f4a3b;
}

/* Sidebar + backlinks lists */
QListWidget {
    background: #101113;
    color: #92b3a2;
    border: none;
    outline: 0;
    padding: 6px;
}
QListWidget::item {
    padding: 7px 10px;
    border-radius: 6px;
    margin: 1px 0;
}
QListWidget::item:hover {
    background: #16241c;
}
QListWidget::item:selected {
    background: #1f4733;
    color: #d7eee2;
}

/* Sidebar note tree (folders + notes) */
QTreeView {
    background: #101113;
    color: #92b3a2;
    border: none;
    outline: 0;
    padding: 6px;
    font-size: 14px;
}
QTreeView::viewport {
    background: #101113;
}
QTreeView::item {
    padding: 8px 8px;
    border-radius: 6px;
    margin: 2px 4px;
}
QTreeView::item:hover {
    background: #16241c;
}
QTreeView::item:selected {
    background: #1f4733;
    color: #d7eee2;
}
/* Paint the branch/indent column with the sidebar background so the row's
   hover/selection fill can't bleed through it as a stray block to the left of
   a nested note. (Our drawBranches() guide lines are drawn on top of this.) */
QTreeView::branch,
QTreeView::branch:hover,
QTreeView::branch:selected {
    background: #101113;
}

/* Sidebar header (title + nav arrows) and footer (gear) */
QWidget#sideFooter {
    background: #101113;
}
QWidget#sideHeader {
    background: #1c3a2c;
}
QLabel#sideTitle {
    /* Transparent so it shows the sidebar header's colour, not the generic
       widget background, behind the "Notes" text. */
    background: transparent;
    color: #d7eee2;
    font-size: 19px;
    font-weight: 600;
    padding: 2px 0;
}
QToolButton#gearButton {
    background: transparent;
    color: #6d8e7c;
    border: none;
    border-radius: 6px;
    padding: 4px 9px;
    font-size: 18px;
}
/* Back / forward arrows (< >): large, bold, easy-to-hit glyphs. The padding
   keeps a generous click target around each arrow regardless of glyph size. */
QToolButton#navButton {
    background: transparent;
    color: #6d8e7c;
    border: none;
    border-radius: 6px;
    padding: 2px 12px;
    font-size: 30px;
    font-weight: 700;
}
QToolButton#navButton:hover, QToolButton#gearButton:hover {
    background: #1f4733;
    color: #d7eee2;
}
QToolButton#navButton:disabled {
    color: #2f4a3b;
}
QToolButton#gearButton::menu-indicator {
    image: none;
}
QLabel#versionLabel {
    background: transparent;
    color: #4f6555;
    font-size: 12px;
    padding-right: 4px;
}

QWidget#mobileEditorBar {
    background: #101113;
}
QToolButton#mobileBarButton {
    background: transparent;
    color: #92b3a2;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 14px;
    font-weight: 600;
    min-height: 30px;
}
QToolButton#mobileBarButton:hover {
    background: #1f4733;
    color: #d7eee2;
}
QToolButton#mobileBarButton::menu-indicator {
    image: none;
}

QWidget#sidebar {
    background: #101113;
}

/* In-pane vault graph. The page occupies the normal note workspace rather
   than a dialog/dock; the canvas itself is painted by GraphView. */
QWidget#graphPage,
QStackedWidget#workspacePages {
    background: #141619;
    border: 0;
    padding: 0;
}
QWidget#graphHeader {
    background: #101113;
    border-bottom: 1px solid #1f4733;
}
QLabel#graphTitle {
    background: transparent;
    color: #d7eee2;
    font-size: 23px;
    font-weight: 700;
}
QLineEdit#graphSearch {
    background: #17181b;
    color: #d7eee2;
    border: 1px solid #2f4a3b;
    border-radius: 6px;
    padding: 6px 9px;
    selection-background-color: #1f4a33;
}
QLineEdit#graphSearch:focus {
    border-color: #2bbf74;
}
QComboBox#graphScope,
QComboBox#graphDepth,
QComboBox#graphFolder,
QComboBox#graphDirection,
QPushButton#graphFit {
    background: #17181b;
    color: #a9c8b8;
    border: 1px solid #2f4a3b;
    border-radius: 5px;
    padding: 4px 8px;
}
QComboBox#graphScope:hover,
QComboBox#graphDepth:hover,
QComboBox#graphFolder:hover,
QComboBox#graphDirection:hover,
QPushButton#graphFit:hover {
    border-color: #2bbf74;
    color: #d7eee2;
}
QWidget#graphCanvasLayer,
QWidget#graphStatusOverlay {
    background: transparent;
}
QLabel#graphStatus,
QLabel#graphSelectionStatus {
    background: rgba(16, 17, 19, 205);
    color: #6d8e7c;
    font-size: 12px;
    border-radius: 4px;
    padding: 4px 7px;
}
QLabel#graphSelectionStatus {
    color: #8faf9e;
}
QWidget#graphCanvas {
    background: #141619;
}

/* The drag-to-resize divider between the sidebar and the workspace. Notes keep
   a wide grab target; Graph View narrows the handle to this painted line so its
   canvas meets the sidebar without a dead gutter. */
QSplitter#mainSplitter::handle {
    background: transparent;
    border-left: 2px solid #1f4733;
}
QSplitter#mainSplitter::handle:hover {
    background: transparent;
    border-left: 2px solid #2bbf74;
}
QSplitter#mainSplitter[graphActive="true"]::handle {
    background: #1f4733;
    border: 0;
}
QSplitter#mainSplitter[graphActive="true"]::handle:hover {
    background: #2bbf74;
    border: 0;
}

QDockWidget {
    color: #4f7565;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background: #101113;
    padding: 8px 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Compact command palette shared by search, quick-open, vault switching,
   templates, and the broken-link report. */
QFrame#searchPopup {
    background: #121512;
    border: 1px solid #315140;
    border-radius: 8px;
}
QWidget#searchPopupHeader {
    background: transparent;
}
QLabel#searchPopupTitle {
    background: transparent;
    color: #d7eee2;
    font-size: 13px;
    font-weight: 700;
}
QLabel#searchMatchCounter,
QLabel#findMatchCounter {
    background: transparent;
    color: #789384;
    font-family: monospace;
    font-size: 11px;
    min-width: 42px;
}
QLabel#searchPopupDismissHint {
    background: #1a211d;
    color: #789384;
    border: 1px solid #294035;
    border-radius: 4px;
    padding: 1px 6px;
    font-family: monospace;
    font-size: 11px;
}
QLineEdit#searchInput {
    background: #181c19;
    color: #d7eee2;
    border: 1px solid #294035;
    border-radius: 5px;
    padding: 7px 9px;
    font-size: 14px;
    selection-background-color: #1f4a33;
}
QLineEdit#searchInput:focus {
    border-color: #39bd79;
}
QListWidget#searchResults {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 90px;
    max-height: 360px;
}
QListWidget#searchResults::item {
    color: #9fbeae;
    padding: 7px 9px;
    border-radius: 4px;
    margin: 1px 0;
}
QListWidget#searchResults::item:hover {
    background: #18241e;
}
QListWidget#searchResults::item:selected {
    background: #1d3d2d;
    color: #e1f4ea;
}
/* In-note find bar (top-right of the editor) */
QFrame#findBar {
    background: #121512;
    border: 1px solid #315140;
    border-radius: 6px;
}
QLineEdit#findInput {
    background: #181c19;
    color: #d7eee2;
    border: 1px solid #294035;
    border-radius: 4px;
    padding: 5px 8px;
    selection-background-color: #1f4a33;
}
QLineEdit#findInput:focus {
    border: 1px solid #2bbf74;
}

/* Hold-to-view keyboard shortcut cheatsheet. It is a child overlay of the
   main window, so it never creates another window or steals keyboard focus. */
QFrame#shortcutCheatsheet {
    background: #121512;
    border: 1px solid #315140;
    border-radius: 9px;
}
QLabel#shortcutCheatsheetTitle {
    background: transparent;
    color: #d7eee2;
    font-size: 22px;
    font-weight: 700;
}
QLabel#shortcutCheatsheetHint {
    background: transparent;
    color: #789384;
    font-size: 13px;
    padding-bottom: 2px;
}
QScrollArea#shortcutCheatsheetScroll,
QScrollArea#shortcutCheatsheetScroll > QWidget > QWidget,
QWidget#shortcutCheatsheetContent,
QWidget#shortcutColumn {
    background: transparent;
    border: none;
}
QFrame#shortcutSection {
    background: #171b18;
    border: 1px solid #263c31;
    border-radius: 6px;
}
QLabel#shortcutSectionTitle {
    background: transparent;
    color: #56cf8c;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0 0 5px 1px;
}
QWidget#shortcutRow,
QLabel#shortcutAction {
    background: transparent;
}
QLabel#shortcutAction {
    color: #abc7b8;
    font-size: 14px;
}
QLabel#shortcutKey {
    background: #1c2d24;
    color: #d9eee3;
    border: 1px solid #315140;
    border-radius: 4px;
    padding: 2px 6px;
    font-family: monospace;
    font-size: 14px;
    font-weight: 600;
}

/* [[ autocomplete popup */
QListView#completer {
    background: #121512;
    color: #d7eee2;
    border: 1px solid #315140;
    border-radius: 5px;
    padding: 3px;
    outline: 0;
}
QListView#completer::item {
    padding: 6px 9px;
    border-radius: 3px;
}
QListView#completer::item:selected {
    background: #1d3d2d;
}

QMenuBar {
    background: #121512;
    color: #a8c3b5;
}
QMenuBar::item:selected {
    background: #1d3d2d;
}
QMenu {
    background: #121512;
    color: #a8c3b5;
    border: 1px solid #315140;
    border-radius: 6px;
    padding: 5px;
}
QMenu::item {
    padding: 6px 24px 6px 10px;
    border-radius: 4px;
    margin: 1px 0;
}
QMenu::item:selected {
    background: #1d3d2d;
    color: #e1f4ea;
}
QMenu::item:disabled {
    color: #4f6559;
}
QMenu::indicator {
    width: 13px;
    height: 13px;
    margin-left: 7px;
}
QMenu::indicator:checked {
    background: #39bd79;
    border: 1px solid #39bd79;
    border-radius: 3px;
}
QMenu::separator {
    height: 1px;
    background: #263c31;
    margin: 5px 7px;
}

/* App-owned dialogs share one compact shell. Specialized dialogs keep their
   own layouts while inheriting the same surface, typography, fields, and
   action hierarchy. Non-native QFileDialogs are used so this also covers the
   Open Vault and Insert Image flows on every platform. */
QDialog {
    background: #171a18;
    color: #a8c3b5;
}
QDialog QLabel,
QDialog QCheckBox,
QDialog QRadioButton,
QDialog QScrollArea,
QDialog QScrollArea > QWidget > QWidget {
    background: transparent;
}
QDialog QAbstractButton {
    outline: none;
}
QLabel#settingsTitle {
    color: #d7eee2;
    font-size: 21px;
    font-weight: 700;
}
QLabel#settingsSubtitle {
    color: #789384;
    font-size: 12px;
}
QTextBrowser#whatsNewContent {
    background: #121512;
    color: #d7eee2;
    border: 1px solid #263c31;
    border-radius: 6px;
    padding: 10px;
    selection-background-color: #1f4a33;
    selection-color: #d7eee2;
}
QFrame#settingsSection {
    background: #121512;
    border: 1px solid #263c31;
    border-radius: 6px;
}
QFrame#settingsSection QWidget {
    background: transparent;
}
QLabel#settingsSectionTitle {
    color: #d7eee2;
    font-size: 14px;
    font-weight: 600;
}
QLabel#settingsSectionDescription {
    color: #789384;
    font-size: 12px;
}
QLabel#settingsFieldLabel {
    color: #9fbaac;
    font-size: 12px;
}
QLabel#themeNameError {
    color: #ef6b73;
    font-size: 12px;
}
QDialog QComboBox,
QDialog QAbstractSpinBox,
QDialog QLineEdit,
QDialog QToolButton#spellLanguage {
    background: #1b1f1c;
    color: #d7eee2;
    border: 1px solid #294035;
    border-radius: 5px;
    padding: 5px 8px;
    min-height: 26px;
    selection-background-color: #1f4a33;
}
QDialog QComboBox:hover,
QDialog QAbstractSpinBox:hover,
QDialog QLineEdit:hover,
QDialog QToolButton#spellLanguage:hover {
    border-color: #3a5e4b;
}
QDialog QComboBox:focus,
QDialog QAbstractSpinBox:focus,
QDialog QLineEdit:focus,
QDialog QToolButton#spellLanguage:focus {
    border-color: #39bd79;
}
QDialog QComboBox::drop-down {
    border: none;
    width: 24px;
}
QDialog QToolButton#spellLanguage::menu-indicator {
    subcontrol-position: right center;
    right: 8px;
}
/* The menu is parented beneath settingsSection. This selector deliberately
   outranks the section's transparent-child rule so macOS paints a solid popup
   surface instead of showing the dialog through it. */
QFrame#settingsSection QMenu#spellLanguageMenu {
    background: #121512;
    color: #a8c3b5;
    border: 1px solid #315140;
}
QDialog QCheckBox,
QDialog QRadioButton {
    color: #d7eee2;
    spacing: 7px;
}
QDialog QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #365344;
    border-radius: 3px;
    background: #1b1f1c;
}
QDialog QCheckBox::indicator:checked {
    background: #39bd79;
    border-color: #39bd79;
}
QDialog QPushButton {
    background: #1b211d;
    color: #aac5b7;
    border: 1px solid #315140;
    border-radius: 5px;
    padding: 6px 13px;
    min-width: 68px;
}
QDialog QPushButton:focus {
    border-color: #39bd79;
}
QDialog QPushButton:hover {
    background: #202c25;
    border-color: #47715a;
    color: #e1f4ea;
}
QDialog QPushButton:pressed {
    background: #18221d;
}
QDialog QPushButton[themeColorRole="true"]:checked {
    background: #1d3d2d;
    color: #e1f4ea;
    border-color: #39bd79;
}
QDialog QPushButton:disabled {
    background: #171b18;
    color: #4f6257;
    border-color: #24362d;
}
QDialog QPushButton[dialogRole="primary"] {
    background: #237349;
    color: #effaf4;
    border-color: #2f9a62;
    font-weight: 600;
}
QDialog QPushButton[dialogRole="primary"]:hover {
    background: #288454;
    border-color: #39bd79;
}
QDialog QPushButton:default {
    background: #237349;
    color: #effaf4;
    border-color: #2f9a62;
    font-weight: 600;
}
QDialog QPushButton[dialogRole="destructive"] {
    background: #522d2d;
    color: #f2d8d8;
    border-color: #794141;
}
QDialog QPushButton[dialogRole="destructive"]:hover {
    background: #633434;
    border-color: #9b5656;
}
QDialog QProgressBar {
    background: #111412;
    border: 1px solid #294035;
    border-radius: 4px;
    min-height: 7px;
    max-height: 7px;
}
QDialog QProgressBar::chunk {
    background: #39bd79;
    border-radius: 3px;
}
QLabel#spellDownloadProgressPercent {
    background: transparent;
    color: #789384;
    font-family: monospace;
    font-size: 11px;
}
QDialog QSlider::groove:horizontal {
    background: #263c31;
    height: 5px;
    border-radius: 2px;
}
QDialog QSlider::sub-page:horizontal {
    background: #2bbf74;
    border-radius: 2px;
}
QDialog QSlider::handle:horizontal {
    background: #39bd79;
    border: 1px solid #237349;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QDialog QSlider::handle:horizontal:hover {
    background: #56cf8c;
}

/* System-style dialogs still receive Emerald's compact content treatment. */
QMessageBox QLabel {
    color: #c8dfd3;
}
QMessageBox QLabel#qt_msgbox_label {
    min-width: 260px;
    padding: 7px 8px 9px 8px;
    qproperty-alignment: AlignCenter;
}
QMessageBox QTextEdit,
QMessageBox QPlainTextEdit {
    background: #111412;
    color: #9fbaac;
    border: 1px solid #294035;
    border-radius: 5px;
    padding: 7px;
}
QFileDialog QTreeView,
QFileDialog QListView {
    background: #121512;
    color: #a8c3b5;
    border: 1px solid #263c31;
    border-radius: 5px;
    padding: 3px;
}
QFileDialog QTreeView::item,
QFileDialog QListView::item {
    padding: 5px 7px;
    margin: 0;
    border-radius: 3px;
}
QFileDialog QTreeView::item:selected,
QFileDialog QListView::item:selected {
    background: #1d3d2d;
    color: #e1f4ea;
}
QFileDialog QHeaderView::section {
    background: #171b18;
    color: #789384;
    border: none;
    border-bottom: 1px solid #263c31;
    padding: 5px 7px;
}
QFileDialog QToolButton {
    background: transparent;
    color: #9fbaac;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
}
QFileDialog QToolButton:hover {
    background: #1d3d2d;
    color: #e1f4ea;
    border-color: #315140;
}
QFileDialog QToolButton:focus,
QToolButton#mascotGalleryItem:focus {
    border-color: #39bd79;
}
/* Qt renders combo-box popups as separate top-level windows, so a QDialog
   ancestor selector does not match them. The view rules cover both ordinary
   combo boxes and the font picker's explicitly named internal view. Item
   padding keeps the spacing painted instead of leaving a transparent gutter
   around the list. */
QComboBox QAbstractItemView,
QAbstractItemView#fontFamilyPopup,
QFrame#settingsSection QAbstractItemView#fontFamilyPopup {
    background-color: #121512;
    color: #a8c3b5;
    border: 1px solid #315140;
    selection-background-color: #1d3d2d;
    selection-color: #e1f4ea;
    outline: 0;
}
QComboBox QAbstractItemView::viewport,
QAbstractItemView#fontFamilyPopup::viewport,
QFrame#settingsSection QAbstractItemView#fontFamilyPopup::viewport {
    background-color: #121512;
}
QComboBox QAbstractItemView::item,
QAbstractItemView#fontFamilyPopup::item,
QFrame#settingsSection QAbstractItemView#fontFamilyPopup::item {
    background-color: #121512;
    color: #a8c3b5;
    padding: 3px;
}
QComboBox QAbstractItemView::item:selected,
QAbstractItemView#fontFamilyPopup::item:selected,
QFrame#settingsSection QAbstractItemView#fontFamilyPopup::item:selected {
    background-color: #1d3d2d;
    color: #e1f4ea;
}

/* The gallery uses the shared dialog shell with dense selectable cards. */
QToolButton#mascotGalleryItem {
    background: #121512;
    color: #aac5b7;
    border: 1px solid #263c31;
    border-radius: 6px;
    padding: 7px;
    font-size: 12px;
}
QToolButton#mascotGalleryItem:hover {
    background: #18241e;
    color: #e1f4ea;
    border-color: #47715a;
}

/* Transient toast notice that floats over the bottom of the editor and
   auto-hides — replaces the old persistent status bar. */
QLabel#toast {
    background: #1f4733;
    color: #d7eee2;
    border: 1px solid #2f4a3b;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
}

/* The per-note mascot paints its own creature with QPainter; the widget itself
   must stay transparent (overriding the global QWidget background) so only the
   creature shows, with the editor visible around it. */
QWidget#mascot {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #1f4733;
    border-radius: 3px;
    min-height: 36px;
}
QScrollBar::handle:vertical:hover {
    background: #2f4a3b;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
/* Kill the horizontal scrollbar entirely (the editor wraps), so its track
   can't show as a thin line across the bottom. */
QScrollBar:horizontal {
    height: 0;
    background: transparent;
}

/* Emerald — neutral charcoal dark theme with emerald accents (selection,
   focus, chevrons) sampled from the app icon. */

QMainWindow,
QWidget {
    background: #17181b;
    color: #a9c8b8;
}

QPlainTextEdit#editor {
    background: #17181b;
    color: #d7eee2;
    border: none;
    selection-background-color: #1f4a33;
    selection-color: #d7eee2;
}

/* The note title shown as the first line above the body (maps to the file
   name; the .md is never shown). */
QLineEdit#noteTitle {
    background: #17181b;
    color: #cfe8dc;
    border: none;
    padding: 18px 18px 14px 18px;
    font-size: 26px;
    font-weight: 700;
    selection-background-color: #1f4a33;
}
QLineEdit#noteTitle::placeholder {
    color: #2f4a3b;
}

/* Sidebar + backlinks lists */
QListWidget {
    background: #101113;
    color: #92b3a2;
    border: none;
    outline: 0;
    padding: 6px;
}
QListWidget::item {
    padding: 7px 10px;
    border-radius: 6px;
    margin: 1px 0;
}
QListWidget::item:hover {
    background: #16241c;
}
QListWidget::item:selected {
    background: #1f4733;
    color: #d7eee2;
}

/* Sidebar note tree (folders + notes) */
QTreeView {
    background: #101113;
    color: #92b3a2;
    border: none;
    outline: 0;
    padding: 6px;
    font-size: 14px;
}
QTreeView::viewport {
    background: #101113;
}
QTreeView::item {
    padding: 8px 8px;
    border-radius: 6px;
    margin: 2px 4px;
}
QTreeView::item:hover {
    background: #16241c;
}
QTreeView::item:selected {
    background: #1f4733;
    color: #d7eee2;
}
/* Paint the branch/indent column with the sidebar background so the row's
   hover/selection fill can't bleed through it as a stray block to the left of
   a nested note. (Our drawBranches() guide lines are drawn on top of this.) */
QTreeView::branch,
QTreeView::branch:hover,
QTreeView::branch:selected {
    background: #101113;
}

/* Sidebar header (title + nav arrows) and footer (gear) */
QWidget#sideFooter {
    background: #101113;
}
QWidget#sideHeader {
    background: #1c3a2c;
}
QLabel#sideTitle {
    /* Transparent so it shows the sidebar header's colour, not the generic
       widget background, behind the "Notes" text. */
    background: transparent;
    color: #d7eee2;
    font-size: 19px;
    font-weight: 600;
    padding: 2px 0;
}
QToolButton#gearButton {
    background: transparent;
    color: #6d8e7c;
    border: none;
    border-radius: 6px;
    padding: 4px 9px;
    font-size: 18px;
}
/* Back / forward arrows (< >): large, bold, easy-to-hit glyphs. The padding
   keeps a generous click target around each arrow regardless of glyph size. */
QToolButton#navButton {
    background: transparent;
    color: #6d8e7c;
    border: none;
    border-radius: 6px;
    padding: 2px 12px;
    font-size: 30px;
    font-weight: 700;
}
QToolButton#navButton:hover, QToolButton#gearButton:hover {
    background: #1f4733;
    color: #d7eee2;
}
QToolButton#navButton:disabled {
    color: #2f4a3b;
}
QToolButton#gearButton::menu-indicator {
    image: none;
}
QLabel#versionLabel {
    background: transparent;
    color: #4f6555;
    font-size: 12px;
    padding-right: 4px;
}

QWidget#mobileEditorBar {
    background: #101113;
}
QToolButton#mobileBarButton {
    background: transparent;
    color: #92b3a2;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 14px;
    font-weight: 600;
    min-height: 30px;
}
QToolButton#mobileBarButton:hover {
    background: #1f4733;
    color: #d7eee2;
}
QToolButton#mobileBarButton::menu-indicator {
    image: none;
}

QWidget#sidebar {
    background: #101113;
}

/* In-pane vault graph. The page occupies the normal note workspace rather
   than a dialog/dock; the canvas itself is painted by GraphView. */
QWidget#graphPage,
QStackedWidget#workspacePages {
    background: #141619;
    border: 0;
    padding: 0;
}
QWidget#graphHeader {
    background: #101113;
    border-bottom: 1px solid #1f4733;
}
QLabel#graphTitle {
    background: transparent;
    color: #d7eee2;
    font-size: 23px;
    font-weight: 700;
}
QLineEdit#graphSearch {
    background: #17181b;
    color: #d7eee2;
    border: 1px solid #2f4a3b;
    border-radius: 6px;
    padding: 6px 9px;
    selection-background-color: #1f4a33;
}
QLineEdit#graphSearch:focus {
    border-color: #2bbf74;
}
QComboBox#graphScope,
QComboBox#graphDepth,
QComboBox#graphFolder,
QComboBox#graphDirection,
QPushButton#graphFit {
    background: #17181b;
    color: #a9c8b8;
    border: 1px solid #2f4a3b;
    border-radius: 5px;
    padding: 4px 8px;
}
QComboBox#graphScope:hover,
QComboBox#graphDepth:hover,
QComboBox#graphFolder:hover,
QComboBox#graphDirection:hover,
QPushButton#graphFit:hover {
    border-color: #2bbf74;
    color: #d7eee2;
}
QWidget#graphCanvasLayer,
QWidget#graphStatusOverlay {
    background: transparent;
}
QLabel#graphStatus,
QLabel#graphSelectionStatus {
    background: rgba(16, 17, 19, 205);
    color: #6d8e7c;
    font-size: 12px;
    border-radius: 4px;
    padding: 4px 7px;
}
QLabel#graphSelectionStatus {
    color: #8faf9e;
}
QWidget#graphCanvas {
    background: #141619;
}

/* The drag-to-resize divider between the sidebar and the workspace. Notes keep
   a wide grab target; Graph View narrows the handle to this painted line so its
   canvas meets the sidebar without a dead gutter. */
QSplitter#mainSplitter::handle {
    background: transparent;
    border-left: 2px solid #1f4733;
}
QSplitter#mainSplitter::handle:hover {
    background: transparent;
    border-left: 2px solid #2bbf74;
}
QSplitter#mainSplitter[graphActive="true"]::handle {
    background: #1f4733;
    border: 0;
}
QSplitter#mainSplitter[graphActive="true"]::handle:hover {
    background: #2bbf74;
    border: 0;
}

QDockWidget {
    color: #4f7565;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background: #101113;
    padding: 8px 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Telescope-style search overlay */
QFrame#searchPopup {
    background: #101113;
    border: 1px solid #2f4a3b;
    border-radius: 10px;
}
QLineEdit#searchInput {
    background: #17181b;
    color: #d7eee2;
    border: 1px solid #1f4733;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 14px;
    selection-background-color: #1f4a33;
}
QLineEdit#searchInput:focus {
    border: 1px solid #2bbf74;
}
/* In-note find bar (top-right of the editor) */
QFrame#findBar {
    background: #101113;
    border: 1px solid #2f4a3b;
    border-radius: 8px;
}
QLineEdit#findInput {
    background: #17181b;
    color: #d7eee2;
    border: 1px solid #1f4733;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #1f4a33;
}
QLineEdit#findInput:focus {
    border: 1px solid #2bbf74;
}

/* Hold-to-view keyboard shortcut cheatsheet. It is a child overlay of the
   main window, so it never creates another window or steals keyboard focus. */
QFrame#shortcutCheatsheet {
    background: #0f1211;
    border: 1px solid #315b46;
    border-radius: 14px;
}
QLabel#shortcutCheatsheetTitle {
    background: transparent;
    color: #e1f4ea;
    font-size: 24px;
    font-weight: 700;
}
QLabel#shortcutCheatsheetHint {
    background: transparent;
    color: #6f9882;
    font-size: 13px;
    padding-bottom: 3px;
}
QScrollArea#shortcutCheatsheetScroll,
QScrollArea#shortcutCheatsheetScroll > QWidget > QWidget,
QWidget#shortcutCheatsheetContent,
QWidget#shortcutColumn {
    background: transparent;
    border: none;
}
QFrame#shortcutSection {
    background: #151b18;
    border: 1px solid #253a30;
    border-radius: 9px;
}
QLabel#shortcutSectionTitle {
    background: transparent;
    color: #58d691;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0 0 5px 1px;
}
QWidget#shortcutRow,
QLabel#shortcutAction {
    background: transparent;
}
QLabel#shortcutAction {
    color: #b8d2c4;
    font-size: 13px;
}
QLabel#shortcutKey {
    background: #1d3227;
    color: #d9eee3;
    border: 1px solid #315b46;
    border-radius: 5px;
    padding: 2px 7px;
    font-family: monospace;
    font-size: 12px;
    font-weight: 600;
}

QListWidget#searchResults {
    background: transparent;
    min-height: 90px;
    max-height: 360px;
}

/* [[ autocomplete popup */
QListView#completer {
    background: #101113;
    color: #d7eee2;
    border: 1px solid #1f4733;
    border-radius: 6px;
    padding: 4px;
    outline: 0;
}
QListView#completer::item {
    padding: 5px 10px;
    border-radius: 4px;
}
QListView#completer::item:selected {
    background: #1f4733;
}

QMenuBar {
    background: #101113;
    color: #a9c8b8;
}
QMenuBar::item:selected {
    background: #1f4733;
}
QMenu {
    background: #101113;
    color: #a9c8b8;
    border: 1px solid #1f4733;
    padding: 4px;
}
QMenu::item {
    padding: 6px 22px;
    border-radius: 5px;
}
QMenu::item:selected {
    background: #1f4733;
}
QMenu::separator {
    height: 1px;
    background: #1f4733;
    margin: 4px 8px;
}

/* Settings dialog */
QDialog#settingsDialog {
    background: #17181b;
}
QDialog#settingsDialog QLabel,
QDialog#settingsDialog QCheckBox {
    background: transparent;
}
QLabel#settingsTitle {
    color: #d7eee2;
    font-size: 24px;
    font-weight: 700;
}
QLabel#settingsSubtitle {
    color: #6f8e7e;
    font-size: 13px;
}
QFrame#settingsSection {
    background: #101113;
    border: 1px solid #20382b;
    border-radius: 8px;
}
QLabel#settingsSectionTitle {
    color: #d7eee2;
    font-size: 15px;
    font-weight: 700;
}
QLabel#settingsSectionDescription {
    color: #6f8e7e;
    font-size: 12px;
}
QLabel#settingsFieldLabel {
    color: #a9c8b8;
    font-size: 13px;
}
QDialog#settingsDialog QComboBox,
QDialog#settingsDialog QAbstractSpinBox,
QDialog#settingsDialog QLineEdit {
    background: #17181b;
    color: #d7eee2;
    border: 1px solid #254232;
    border-radius: 6px;
    padding: 6px 9px;
    min-height: 28px;
    selection-background-color: #1f4a33;
}
QDialog#settingsDialog QComboBox:focus,
QDialog#settingsDialog QAbstractSpinBox:focus,
QDialog#settingsDialog QLineEdit:focus {
    border: 1px solid #2bbf74;
}
QDialog#settingsDialog QComboBox::drop-down {
    border: none;
    width: 26px;
}
QDialog#settingsDialog QCheckBox {
    color: #d7eee2;
    spacing: 8px;
}
QDialog#settingsDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2f4a3b;
    border-radius: 4px;
    background: #17181b;
}
QDialog#settingsDialog QCheckBox::indicator:checked {
    background: #2bbf74;
    border: 1px solid #2bbf74;
}
QDialog#settingsDialog QPushButton {
    background: #1f4733;
    color: #d7eee2;
    border: 1px solid #2f4a3b;
    border-radius: 6px;
    padding: 7px 16px;
    min-width: 72px;
}
QDialog#settingsDialog QPushButton:hover {
    background: #286044;
}
QDialog#settingsDialog QPushButton:pressed {
    background: #183927;
}
QDialog#settingsDialog QPushButton:disabled {
    background: #16241c;
    color: #4f6555;
    border: 1px solid #20382b;
}

/* Transient toast notice that floats over the bottom of the editor and
   auto-hides — replaces the old persistent status bar. */
QLabel#toast {
    background: #1f4733;
    color: #d7eee2;
    border: 1px solid #2f4a3b;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
}

/* The per-note mascot paints its own creature with QPainter; the widget itself
   must stay transparent (overriding the global QWidget background) so only the
   creature shows, with the editor visible around it. */
QWidget#mascot {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #1f4733;
    border-radius: 3px;
    min-height: 36px;
}
QScrollBar::handle:vertical:hover {
    background: #2f4a3b;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
/* Kill the horizontal scrollbar entirely (the editor wraps), so its track
   can't show as a thin line across the bottom. */
QScrollBar:horizontal {
    height: 0;
    background: transparent;
}
